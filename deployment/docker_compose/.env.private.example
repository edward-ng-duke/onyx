# =============================================================================
# Onyx PRIVATE DEPLOYMENT — seed env file
# =============================================================================
# This file is the seed for private deployments of Onyx. On first run,
# `make init` (see /Makefile) copies this file to ./.env and auto-fills any
# empty USER_AUTH_SECRET / ENCRYPTION_KEY_SECRET lines with `openssl rand
# -hex 32`. Subsequent runs of `make init` are idempotent — already-filled
# values are preserved.
#
# Network legend (used in the section markers below):
#   # [外网]  = service / key whose value is allowed to reach the PUBLIC internet
#   # [内网]  = stays inside the Docker compose network only
#   # [本地]  = local file / value, never sent over the wire
#
# Egress policy: in the private deployment, only the `searxng` container is
# permitted to reach the public internet. Optionally, if you configure a
# third-party web-search API key (Serper / Brave / Google PSE / Exa), the
# api_server itself will also egress when that provider is invoked. Everything
# else — Postgres, Redis, Vespa, MinIO, model servers, the LLM proxy — stays
# on the internal Docker network.
#
# `<REQUIRED>` placeholders MUST be replaced before `make up`.
# Empty values (KEY=) are intentional — `make init` fills them.
# =============================================================================


# === CORE / IMAGE ===
IMAGE_TAG=latest
# Onyx Craft is the AI-app-builder add-on. Not needed for a basic private
# deployment. Uncomment (and switch IMAGE_TAG to craft-latest) only if you
# explicitly want it.
# ENABLE_CRAFT=true
# IMAGE_TAG=craft-latest


# === AUTH ===  # [本地]
AUTH_TYPE=basic
# USER_AUTH_SECRET / ENCRYPTION_KEY_SECRET are intentionally empty.
# `make init` fills them with `openssl rand -hex 32` on first run.
# If setting manually, run:  openssl rand -hex 32
USER_AUTH_SECRET=
ENCRYPTION_KEY_SECRET=
# Comma-separated allowlist for signup/login. Leave commented to allow any.
# VALID_EMAIL_DOMAINS=example.com,corp.local


# === DATABASE ===  # [内网]
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REQUIRED>
POSTGRES_HOST=relational_db


# === CACHE / REDIS ===  # [内网]
REDIS_HOST=cache


# === SEARCH INDEX (Vespa) ===  # [内网]
VESPA_HOST=index


# === OPENSEARCH ===  # [内网]
# Optional second-tier text search. The baseline private deployment runs fine
# without it. Enable only if you specifically want OpenSearch.
OPENSEARCH_FOR_ONYX_ENABLED=false


# === FILE STORAGE (MinIO/S3) ===  # [内网]
# COMPOSE_PROFILES=s3-filestore activates the bundled MinIO service.
# The override file keeps MinIO internal-only (no host port publication).
COMPOSE_PROFILES=s3-filestore
FILE_STORE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_AWS_ACCESS_KEY_ID=minioadmin
# Default credentials are fine for a sealed internal network. Change for
# production-grade deployments.
S3_AWS_SECRET_ACCESS_KEY=minioadmin
S3_FILE_STORE_BUCKET_NAME=onyx-file-store-bucket
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin


# === MODEL SERVER POINTERS ===  # [内网]
MODEL_SERVER_HOST=inference_model_server
INDEXING_MODEL_SERVER_HOST=indexing_model_server
INTERNAL_URL=http://api_server:8080


# === LLM via internal OpenAI-compatible proxy ===  # [内网]
# In a private deployment, LLM calls do NOT reach the public OpenAI API.
# They are routed through your enterprise OpenAI-compatible proxy, which
# the operator configures inside the admin UI's "LLM Provider" page
# (set OPENAI_API_BASE / api_base there to the proxy URL).
# The key below is just the bearer token Onyx presents to that proxy.
# Uncomment and set before `make up`.
# GEN_AI_API_KEY=<REQUIRED>


# === EMBEDDING ===  # [内网]
# Embedding is configured via the admin UI's "Search Settings" page — there
# is no dedicated env var here. To run without a GPU, choose the "LiteLLM"
# provider type and point it at the same internal OpenAI-compatible proxy
# used for the LLM. The bundled model_server containers then act as a
# near-idle proxy and do not need a GPU.


# === WEB SEARCH (only egress-permitted component) ===  # [外网]
# SearXNG is self-hosted (see docker-compose.private.override.yml) and is the
# default web-search backend. SearXNG itself routes through public search
# engines (Google / Bing / DuckDuckGo / etc.), so the searxng container is
# the only Onyx service permitted to reach the public internet.
SEARXNG_BASE_URL=http://searxng:8080/
# Choose ONE provider OR use SearXNG OR both. Setting any third-party API
# key below causes api_server itself to egress when that provider is invoked
# — limit to one if your firewall is strict.
# SERPER_API_KEY=
# BRAVE_API_KEY=
# GOOGLE_PSE_API_KEY=
# GOOGLE_PSE_ENGINE_ID=
# EXA_API_KEY=


# === TELEMETRY (off) ===  # [本地]
LOG_LEVEL=info
# DISABLE_TELEMETRY is also force-set to true in the override file for
# api_server + background; setting it here keeps it consistent everywhere.
DISABLE_TELEMETRY=true
# Leave empty for private deployments. PostHog is EE-only and would phone
# home if set.
# POSTHOG_API_KEY=
# Same reasoning — Sentry would forward error events to sentry.io.
# SENTRY_DSN=


# === CONNECTORS (default disabled) ===
# All cloud connectors below stay disabled by default — Onyx silently skips
# them when their tokens/keys are absent. Only enable a connector if you
# accept its egress.
# Gmail / Google Drive OAuth (egress to accounts.google.com)         # [外网]
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Discord bot (egress to discord.com)                                # [外网]
# DISCORD_BOT_TOKEN=
# Generic OAuth / OIDC for SSO (egress to your IdP)                  # [外网]
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OPENID_CONFIG_URL=
# Egnyte (egress to egnyte.com)                                      # [外网]
# EGNYTE_CLIENT_ID=
# EGNYTE_CLIENT_SECRET=
# Linear (egress to linear.app)                                      # [外网]
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=


# === NGINX / TIMEOUTS ===  # [本地]
# Increase if long-running requests time out at the proxy layer.
# NGINX_PROXY_CONNECT_TIMEOUT=300
# NGINX_PROXY_SEND_TIMEOUT=300
# NGINX_PROXY_READ_TIMEOUT=300
